# =============================================================================
# CloudCraft Studio — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# The canonical URL of the deployed application.
# Vercel sets this automatically via VERCEL_URL; override only if using a custom domain.
# NEXT_PUBLIC_APP_URL=https://cloudcraft.example.com

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Feature Flags (optional) ─────────────────────────────────────────────────
# Enable experimental features in development
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL=false
